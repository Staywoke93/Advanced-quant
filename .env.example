# Configure these as GitHub Actions secrets/variables, or export them locally.
NTFY_TOPIC=use-a-long-unguessable-topic
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
ACCOUNT_EQUITY=1000
ACCOUNT_CURRENCY=USD
RISK_PER_TRADE=0.0025
DAILY_LOSS_LIMIT=0.01
MAX_SIMULTANEOUS_SIGNALS=2
MIN_CONFIDENCE=0.64
SESSION_START_UTC=12:00
SESSION_END_UTC=15:00
ENFORCE_SESSION=true
HORIZON_BARS=3
DATA_INTERVAL=1h
DATA_PERIOD=730d
